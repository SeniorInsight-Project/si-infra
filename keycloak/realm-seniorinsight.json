{
  "realm": "seniorinsight",
  "enabled": true,
  "displayName": "SeniorInsight (local)",
  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "verifyEmail": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "rememberMe": false,
  "ssoSessionIdleTimeout": 2592000,
  "ssoSessionMaxLifespan": 31536000,
  "actionTokenGeneratedByUserLifespan": 86400,
  "attributes": {
    "actionTokenGeneratedByUserLifespan.verify-email": "86400"
  },
  "passwordPolicy": "length(10) and digits(1) and regexPattern(.*[A-Za-z].*) and notEmail",
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 5,
  "waitIncrementSeconds": 900,
  "maxFailureWaitSeconds": 900,
  "maxDeltaTimeSeconds": 900,
  "quickLoginCheckMilliSeconds": 0,
  "minimumQuickLoginWaitSeconds": 900,
  "internationalizationEnabled": true,
  "supportedLocales": ["pt-BR", "en"],
  "defaultLocale": "pt-BR",
  "loginTheme": "seniorinsight",
  "emailTheme": "seniorinsight",
  "smtpServer": {
    "host": "mailpit",
    "port": "1025",
    "from": "nao-responda@seniorinsight.local",
    "fromDisplayName": "SeniorInsight",
    "auth": "false",
    "ssl": "false",
    "starttls": "false"
  },
