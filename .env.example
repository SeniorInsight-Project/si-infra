# Configuração local de desenvolvimento. Não reutilize estas credenciais fora da máquina local.

# Postgres: usuário de administração. Cada serviço tem banco e usuário próprios (care, identity, notification,
# telemetry, insight, report, billing, keycloak, openwearables), todos com a senha DB_PASSWORD.
DB_NAME=seniorinsight
DB_USERNAME=seniorinsight
DB_PASSWORD=seniorinsight
DB_PORT=5432

REDIS_PORT=6379

RABBITMQ_USERNAME=seniorinsight
RABBITMQ_PASSWORD=seniorinsight
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_PORT=8180
# Secrets dos clients confidenciais do realm. Gere valores próprios (ex.: openssl rand -hex 32).
SI_WEB_CLIENT_SECRET=troque-este-secret-si-web
SI_IDENTITY_SERVICE_CLIENT_SECRET=troque-este-secret-si-identity-service
# Clients de serviço (client credentials) das chamadas entre serviços: insight e notification no /internal/** do
# care (role servico-interno) e care no trial do billing (scope billing.trial.write).
SI_INSIGHT_SERVICE_CLIENT_SECRET=troque-este-secret-si-insight-service
SI_NOTIFICATION_SERVICE_CLIENT_SECRET=troque-este-secret-si-notification-service
SI_CARE_SERVICE_CLIENT_SECRET=troque-este-secret-care-service
# Login com Google no Keycloak: client secret do OAuth client "seniorinsight-auth" (Vaultwarden).
GOOGLE_CLIENT_SECRET=

MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# MinIO (PDFs do report-service). A senha precisa ter pelo menos 8 caracteres.
MINIO_ROOT_USER=seniorinsight
MINIO_ROOT_PASSWORD=seniorinsight-minio
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

GATEWAY_PORT=8080
GATEWAY_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081

# telemetry-service: segredo da referência do idoso no Open Wearables. Pelo menos 32 bytes (ex.: openssl rand -hex 32)
# e nunca trocado depois de haver vínculos, senão o serviço perde a referência dos idosos já vinculados.
OPENWEARABLES_VINCULO_SECRET=troque-este-segredo-de-vinculo-local-com-32-bytes-ou-mais
# Coleta do Open Wearables: ligue só depois de subir com --profile ow e criar a API key no portal (README-local.md).
OPENWEARABLES_ENABLED=false
OPENWEARABLES_API_KEY=

# Open Wearables (profile "ow"): API em OW_API_PORT e portal em OW_FRONTEND_PORT.
OW_API_PORT=8000
OW_FRONTEND_PORT=3000
OW_SECRET_KEY=troque-este-secret-key-local-do-open-wearables
OW_ADMIN_EMAIL=admin@seniorinsight.local
OW_ADMIN_PASSWORD=SenhaAdminOw2026

# insight-service: Score com o Gemini. Só roda com INSIGHT_GEMINI_ENABLED=true, GEMINI_API_KEY e teto e tarifas
# maiores que zero, na mesma moeda (micros = milionésimos). Exemplo em dólar, conferir a tabela atual do Gemini:
# teto de US$ 1,00 por dia = 1000000; entrada US$ 0,30 e saída US$ 2,50 por milhão de tokens = 300000 e 2500000.
INSIGHT_GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
INSIGHT_GEMINI_TETO_DIARIO_MICROS=0
INSIGHT_GEMINI_PRECO_ENTRADA=0
INSIGHT_GEMINI_PRECO_SAIDA=0

# notification-service: token de acesso do Expo Push (opcional localmente).
EXPO_ACCESS_TOKEN=

# billing-service: preço mensal do Premium em centavos (vazio = sem preço) e Stripe (só exclusão LGPD por enquanto).
BILLING_PREMIUM_PRECO_CENTAVOS=
STRIPE_ERASURE_ENABLED=false
STRIPE_SECRET_KEY=
